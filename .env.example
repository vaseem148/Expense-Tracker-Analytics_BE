NODE_ENV=development
PORT=4000

# SQLite by default so the project runs with zero infrastructure.
DATABASE_URL="file:./expense.db"

# Generate real values before deploying: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_32_bytes_of_entropy
JWT_REFRESH_SECRET=replace_me_with_a_different_32_bytes
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
DEFAULT_CURRENCY=INR

# Optional Python data-science service; the API falls back to in-process
# heuristics when this is unreachable.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=4000

# AES-256-GCM key for integration credentials: openssl rand -hex 32
ENCRYPTION_KEY=replace_me_with_64_hex_characters
WEBHOOK_MAX_RETRIES=5
